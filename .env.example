# MongoDB Atlas (free M0 tier works)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/opengagan

# OpenSky Network OAuth2 — https://opensky-network.org/index.php/registration
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# NASA FIRMS — https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# OpenWeatherMap — https://openweathermap.org/api (free 1000 calls/day)
OWM_API_KEY=

# CORS — set to your frontend URL in production
FRONTEND_URL=http://localhost:5173

# Frontend (Vite) — read from root .env via envDir: '..' in vite.config.ts
VITE_API_URL=http://localhost:4000

# Server
PORT=4000
NODE_ENV=development

# India ADS-B bounding box (override if needed)
INDIA_LAT_MIN=6.5
INDIA_LAT_MAX=37
INDIA_LON_MIN=68
INDIA_LON_MAX=97.5
